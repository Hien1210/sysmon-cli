{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build sysmon-cli (g++)",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++17",
                "-O2",
                "-Wall",
                "-Wextra",
                "-Iinclude",
                "src/main.cpp",
                "src/system_collector.cpp",
                "-o",
                "sysmon-cli.exe",
                "-lpsapi"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}
